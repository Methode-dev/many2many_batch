<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="many2many_batch.RecordsTableDialog">
    <Dialog size="props.size or 'xl'"
            title="props.title or 'Details'"
            contentClass="'o_m2m_b_table_dialog'">
        <!-- The table scrolls inside the dialog rather than stretching it, so a
             long column list never pushes the buttons off-screen. -->
        <div class="o_m2m_b_table_scroll" t-ref="root">
            <table class="o_m2m_b_full_table table table-sm table-bordered mb-0">
                <thead>
                    <tr>
                        <th t-foreach="columns" t-as="column" t-key="column.name">
                            <t t-esc="label(column)"/>
                        </th>
                        <!-- Row action in a column of its own, pinned to the right
                             edge (see the scss) — only when no column hosts it. -->
                        <th t-if="hasEditColumn" class="o_m2m_b_row_action"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="props.records" t-as="record" t-key="record.id"
                        t-att-class="{ 'o_m2m_b_table_active_row': isActive(record) }">
                        <td t-foreach="columns" t-as="column" t-key="column.name"
                            class="align-middle">
                            <div t-if="editsFrom(column)" class="o_m2m_b_cell_with_action">
                                <GroupByCell record="record"
                                             name="column.name"
                                             readonly="props.readonly"
                                             onChanged="canAutoSave ? onCellChanged : undefined"/>
                                <!-- Same affordance Odoo puts on a many2one: an
                                     arrow through to the record that owns this
                                     value. -->
                                <button class="btn btn-link btn-sm px-1 py-0 o_m2m_b_cell_action"
                                        t-on-click="() => this.onEditRow(record)"
                                        title="Open the record this value belongs to">
                                    <i class="oi oi-arrow-right"/>
                                </button>
                            </div>
                            <GroupByCell t-else=""
                                         record="record"
                                         name="column.name"
                                         readonly="props.readonly"
                                         onChanged="canAutoSave ? onCellChanged : undefined"/>
                        </td>
                        <td t-if="hasEditColumn" class="o_m2m_b_row_action align-middle">
                            <button class="btn btn-link btn-sm py-0"
                                    t-on-click="() => this.onEditRow(record)"
                                    title="Open this record's own form to edit its details">
                                <i class="fa fa-pencil"/>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="() => this.onClose()">
                Close
            </button>
            <!-- Auto-save: there is nothing to confirm, so say so rather than
                 leaving the user wondering whether Close discards their work. -->
            <span t-if="canAutoSave" class="text-muted ms-2 align-self-center">
                <i class="fa fa-check me-1"/>Changes are saved as you type
            </span>
        </t>
    </Dialog>
</t>

</templates>
